{
  "name": "aihome-workspace",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@aihome/web",
    "dev:api": "npm run dev --workspace=@aihome/api",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run --config packages/config/vitest.config.ts",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run format:check && npm run test"
  },
  "devDependencies": {
    "vitest": "^1.6.0",
    "@playwright/test": "^1.44.0",
    "eslint": "^9.0.0",
    "prettier": "^3.2.5",
    "typescript": "~5.4.5"
  }
}
